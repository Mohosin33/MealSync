rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedInAndVerified() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedInAndVerified() && request.auth.uid == uid;
    }

    function isMessManager(messId) {
      return isSignedInAndVerified() &&
        exists(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid)).data.role == 'manager';
    }

    function isMessManagerAfter(messId) {
      let memberPath = /databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid);
      let messPath = /databases/$(database)/documents/messes/$(messId);
      return isMessManager(messId) ||
        (isSignedInAndVerified() &&
         existsAfter(memberPath) &&
         getAfter(memberPath).data.role == 'manager' &&
         existsAfter(messPath) &&
         getAfter(messPath).data.managerUid == request.auth.uid);
    }

    function isMessMember(messId) {
      return isSignedInAndVerified() &&
        exists(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid));
    }

    function isMessActive(messId) {
      let messPath = /databases/$(database)/documents/messes/$(messId);
      return (exists(messPath) && get(messPath).data.get('deleting', false) == false) ||
        (!exists(messPath) && existsAfter(messPath) &&
         getAfter(messPath).data.get('deleting', false) == false);
    }

    function formatDate(t) {
      let yearStr = string(t.year());
      let monthStr = t.month() < 10 ? '0' + string(t.month()) : string(t.month());
      let dayStr = t.day() < 10 ? '0' + string(t.day()) : string(t.day());
      return yearStr + '-' + monthStr + '-' + dayStr;
    }

    function formatTime(t) {
      let hourStr = t.hours() < 10 ? '0' + string(t.hours()) : string(t.hours());
      let minStr = t.minutes() < 10 ? '0' + string(t.minutes()) : string(t.minutes());
      return hourStr + ':' + minStr;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedInAndVerified();
      allow create: if isUser(userId);
      allow update: if isUser(userId) || (
        isSignedInAndVerified() &&
        resource.data.messId != null &&
        isMessManager(resource.data.messId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messId', 'role'])
      );
    }

    // Invitation Codes collection
    match /invitationCodes/{code} {
      allow get: if isSignedInAndVerified() && code.matches('^[0-9]{6}$');
      allow list: if isSignedInAndVerified() && isMessManager(resource.data.messId);
      allow create: if isSignedInAndVerified() &&
        code.matches('^[0-9]{6}$') &&
        isMessActive(request.resource.data.messId);
      allow update: if isSignedInAndVerified() &&
        (isMessManager(resource.data.messId) || request.auth.uid == resource.data.createdBy);
      allow delete: if isSignedInAndVerified() && isMessManager(resource.data.messId);
    }

    // Messes collection
    match /messes/{messId} {
      allow read: if isMessMember(messId);
      allow create: if isSignedInAndVerified();
      allow update: if isMessManager(messId) && isMessActive(messId);
      allow delete: if isMessManager(messId);

      // Subcollection: Periods
      match /periods/{periodId} {
        allow read: if isMessMember(messId);

        allow create: if isMessActive(messId) && isMessManagerAfter(messId) &&
          periodId.matches('^[0-9]{4}-[0-9]{2}$') &&
          request.resource.data.status == 'open';

        allow update: if isMessActive(messId) && isMessManager(messId) &&
          resource.data.status != 'closed' && (
            (resource.data.status == 'open' &&
             request.resource.data.status == 'closing' &&
             request.resource.data.closeRequestId is string &&
             request.resource.data.closingStartedAt == request.time &&
             formatDate(request.time + duration.value(get(/databases/$(database)/documents/messes/$(messId)).data.utcOffsetMinutes, 'm')) >= resource.data.endDate
            ) ||
            (resource.data.status == 'closing' &&
             request.resource.data.status == 'closed' &&
             request.resource.data.closeRequestId == resource.data.closeRequestId &&
             request.resource.data.closedAt == request.time &&
             request.resource.data.closedBy == request.auth.uid &&
             request.resource.data.nextPeriodId is string &&
             exists(/databases/$(database)/documents/messes/$(messId)/periods/$(request.resource.data.nextPeriodId)) &&
             getAfter(/databases/$(database)/documents/messes/$(messId)).data.currentPeriodId == request.resource.data.nextPeriodId
            )
          );

        allow delete: if isMessManager(messId);

        // Subcollection: Results
        match /results/{uid} {
          allow read: if isMessMember(messId) && (isMessManager(messId) || uid == request.auth.uid);
          allow create, update: if isMessActive(messId) && isMessManager(messId) &&
            exists(/databases/$(database)/documents/messes/$(messId)/periods/$(periodId)) &&
            get(/databases/$(database)/documents/messes/$(messId)/periods/$(periodId)).data.status == 'closing';
          allow delete: if isMessManager(messId);
        }
      }

      // Subcollection: Members
      match /members/{memberUid} {
        allow read: if isMessMember(messId);
        allow create: if isSignedInAndVerified() && request.auth.uid == memberUid && isMessActive(messId);
        allow update: if isMessActive(messId) && (isUser(memberUid) || (
          isMessManager(messId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['includeInFixed'])
        ));
        allow delete: if isMessManager(messId) || (isMessActive(messId) && isUser(memberUid));
      }

      // Subcollection: Meals
      match /meals/{mealId} {
        allow read: if isMessMember(messId);

        allow create, update: if isMessActive(messId) && isMessMember(messId) &&
          request.resource.data.uid == request.auth.uid &&
          mealId == request.resource.data.date + '_' + request.auth.uid &&
          request.resource.data.keys().hasOnly(['date', 'uid', 'lunch', 'dinner', 'guests', 'updatedAt']) &&
          request.resource.data.lunch is bool &&
          request.resource.data.dinner is bool &&
          request.resource.data.guests is int &&
          request.resource.data.guests >= 0 &&
          request.resource.data.guests <= 10 &&
          request.resource.data.updatedAt == request.time &&
          // Allow late creation only for the default meal; edits still require an open cutoff.
          exists(/databases/$(database)/documents/messes/$(messId)) &&
          get(/databases/$(database)/documents/messes/$(messId)).data.utcOffsetMinutes is int &&
          get(/databases/$(database)/documents/messes/$(messId)).data.cutoffTime is string &&
          request.resource.data.date == formatDate(
            request.time + duration.value(get(/databases/$(database)/documents/messes/$(messId)).data.utcOffsetMinutes, 'm') + duration.value(24, 'h')
          ) &&
          (
            formatTime(
              request.time + duration.value(get(/databases/$(database)/documents/messes/$(messId)).data.utcOffsetMinutes, 'm')
            ) < get(/databases/$(database)/documents/messes/$(messId)).data.cutoffTime ||
            (resource == null &&
             request.resource.data.lunch == true &&
             request.resource.data.dinner == true &&
             request.resource.data.guests == 0)
          );

        allow delete: if isMessManager(messId);
      }

      // Subcollection: Expenses
      match /expenses/{expenseId} {
        allow read: if isMessMember(messId);

        allow create: if isMessActive(messId) && isMessManager(messId) &&
          request.resource.data.amountPaisa is int &&
          request.resource.data.amountPaisa >= 1 &&
          request.resource.data.amountPaisa <= 100000000 &&
          request.resource.data.type == 'fixed' &&
          request.resource.data.category in ['groceries', 'utilities', 'wi_fi', 'cooks_salary', 'cleaning', 'maintenance', 'other'] &&
          request.resource.data.description is string &&
          request.resource.data.description.size() >= 1 &&
          request.resource.data.description.size() <= 200 &&
          exists(/databases/$(database)/documents/messes/$(messId)) &&
          get(/databases/$(database)/documents/messes/$(messId)).data.currentPeriodId is string &&
          request.resource.data.periodId == get(/databases/$(database)/documents/messes/$(messId)).data.currentPeriodId &&
          exists(/databases/$(database)/documents/messes/$(messId)/periods/$(request.resource.data.periodId)) &&
          get(/databases/$(database)/documents/messes/$(messId)/periods/$(request.resource.data.periodId)).data.status == 'open' &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.keys().hasOnly(['id', 'amountPaisa', 'description', 'category', 'type', 'expenseDate', 'periodId', 'createdBy', 'createdAt', 'correctsId']);

        allow update: if false;
        allow delete: if isMessManager(messId);
      }

      // Subcollection: Deposits
      match /deposits/{depositId} {
        allow read: if isMessMember(messId) && (isMessManager(messId) || resource == null || resource.data.memberId == request.auth.uid);

        allow create: if isMessActive(messId) && isMessMember(messId) &&
          (isMessManager(messId) || request.resource.data.memberId == request.auth.uid) &&
          exists(/databases/$(database)/documents/messes/$(messId)/members/$(request.resource.data.memberId)) &&
          request.resource.data.amountPaisa is int &&
          request.resource.data.amountPaisa >= 1 &&
          request.resource.data.amountPaisa <= 100000000 &&
          request.resource.data.method in ['cash', 'bank', 'bkash', 'nagad', 'other'] &&
          exists(/databases/$(database)/documents/messes/$(messId)) &&
          get(/databases/$(database)/documents/messes/$(messId)).data.currentPeriodId is string &&
          request.resource.data.periodId == get(/databases/$(database)/documents/messes/$(messId)).data.currentPeriodId &&
          exists(/databases/$(database)/documents/messes/$(messId)/periods/$(request.resource.data.periodId)) &&
          get(/databases/$(database)/documents/messes/$(messId)/periods/$(request.resource.data.periodId)).data.status == 'open' &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.status in ['pending', 'approved'] &&
          (isMessManager(messId) || request.resource.data.status == 'pending') &&
          request.resource.data.keys().hasOnly(['id', 'memberId', 'amountPaisa', 'method', 'description', 'periodId', 'status', 'createdBy', 'createdAt', 'correctsId']);

        allow update: if isMessActive(messId) && isMessManager(messId) &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.reviewedBy == request.auth.uid &&
          request.resource.data.reviewedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']) &&
          get(/databases/$(database)/documents/messes/$(messId)/periods/$(resource.data.periodId)).data.status == 'open';
        allow delete: if isMessManager(messId);
      }

      // Subcollection: Adjustments
      match /adjustments/{adjId} {
        allow read: if isMessMember(messId) && (
          resource.data.type == 'reversal' ||
          isMessManager(messId) ||
          resource.data.memberId == request.auth.uid
        );

        allow create: if isMessActive(messId) && isMessManager(messId) &&
          request.resource.data.type in ['reversal', 'member_adjustment'] &&
          exists(/databases/$(database)/documents/messes/$(messId)) &&
          get(/databases/$(database)/documents/messes/$(messId)).data.currentPeriodId is string &&
          request.resource.data.periodId == get(/databases/$(database)/documents/messes/$(messId)).data.currentPeriodId &&
          exists(/databases/$(database)/documents/messes/$(messId)/periods/$(request.resource.data.periodId)) &&
          get(/databases/$(database)/documents/messes/$(messId)/periods/$(request.resource.data.periodId)).data.status == 'open' &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          (
            (request.resource.data.type == 'reversal' &&
             request.resource.data.targetType in ['expense', 'deposit'] &&
             (
               (request.resource.data.targetType == 'expense' && exists(/databases/$(database)/documents/messes/$(messId)/expenses/$(request.resource.data.targetId))) ||
               (request.resource.data.targetType == 'deposit' && exists(/databases/$(database)/documents/messes/$(messId)/deposits/$(request.resource.data.targetId)))
             )
            ) ||
            (request.resource.data.type == 'member_adjustment' &&
             exists(/databases/$(database)/documents/messes/$(messId)/members/$(request.resource.data.memberId)) &&
             request.resource.data.amountPaisa is int &&
             request.resource.data.amountPaisa != 0
            )
          );

        allow update: if false;
        allow delete: if isMessManager(messId);
      }
    }
  }
}
