<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.finance.CloseMonthActivity">

    <View
        android:id="@+id/bgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_manager" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="48dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_close_month"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCloseSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/close_month_subtitle"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Sheet -->
            <LinearLayout
                android:id="@+id/sheet"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sheet_top"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <!-- Preview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/ms_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvPeriodDates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ms_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Period: 2025-05-01 to 2025-05-31" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvPreviewRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ms_teal"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Final Rate: ৳42.50 / meal" />

                        <TextView
                            android:id="@+id/tvPreviewTotals"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/ms_text_primary"
                            android:textSize="14sp"
                            tools:text="Meals: 140 | Meal Charges: ৳5,950 | Fixed Expenses: ৳3,000 | Deposits: ৳10,000" />

                        <TextView
                            android:id="@+id/tvPreviewMembers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/ms_text_secondary"
                            android:textSize="13sp"
                            tools:text="Members: 5 | Total Surplus: ৳2,500 | Total Owed: ৳1,450" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Warning Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF3CD"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFEEBA"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvWarningText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:textColor="#856404"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Set a fixed meal rate in Mess Settings before closing this period." />
                </com.google.android.material.card.MaterialCardView>

                <!-- Progress Steps Container -->
                <LinearLayout
                    android:id="@+id/layoutSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvStep1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/close_step_lock_period"
                        android:textColor="@color/ms_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStep2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/close_step_calculate_snapshot"
                        android:textColor="@color/ms_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStep3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/close_step_write_results"
                        android:textColor="@color/ms_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStep4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/close_step_create_period"
                        android:textColor="@color/ms_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStep5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/close_step_finalize"
                        android:textColor="@color/ms_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/close_month_irreversible_confirmation"
                    android:textColor="@color/ms_text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseMonthConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:minHeight="56dp"
                    android:text="@string/label_close_month"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="52dp"
                    android:text="@string/retry_close_month"
                    android:visibility="gone"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
