<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MealSync" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ms_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/ms_surface</item>
        <item name="colorOnPrimaryContainer">@color/ms_text_primary</item>
        <item name="colorSecondary">@color/ms_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/ms_card</item>
        <item name="colorOnSurface">@color/ms_text_primary</item>
        <item name="colorSurfaceVariant">@color/ms_divider</item>
        <item name="colorOnSurfaceVariant">@color/ms_text_secondary</item>
        <item name="colorOutline">@color/ms_divider</item>
        <item name="colorError">@color/ms_negative</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorAccent">@color/ms_teal</item>
        <item name="android:windowBackground">@color/ms_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MealSync" parent="Base.Theme.MealSync" />

    <style name="TextAppearance.MealSync.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ms_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MealSync.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ms_text_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
